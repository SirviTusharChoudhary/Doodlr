{
  "name": "doodlr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/server & npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "start": "npm run start --workspace=apps/server",
    "start:client": "npm run preview --workspace=apps/client",
    "build": "npm run build --workspace=apps/client",
    "install:all": "npm install"
  }
}
